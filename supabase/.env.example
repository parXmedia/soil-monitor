# Copy to .env.local for local development. Never commit the copied file.
SOIL_DEVICE_ID=garden-sensor-1
SOIL_INGEST_SECRET=replace-with-at-least-32-random-characters
SOIL_ALLOWED_ORIGIN=https://YOUR-GITHUB-USER.github.io
SOIL_MAX_CLOCK_SKEW_SECONDS=300

# --- alert-monitor -----------------------------------------------------------
# Shared secret the scheduler presents as "Authorization: Bearer <secret>".
SOIL_CRON_SECRET=replace-with-another-32-character-random-secret

# Delivery channels. Configure at least one, or alerts are evaluated and
# latched but never actually reach you. Both are attempted; either succeeding
# counts as delivered.
RESEND_API_KEY=
SOIL_ALERT_FROM=garden@example.com
SOIL_ALERT_TO=you@example.com

# Any HTTPS endpoint that accepts a JSON POST (ntfy, Pushover bridge, Slack).
SOIL_ALERT_WEBHOOK_URL=

# Appended to alert messages so the notification links back to the dashboard.
SOIL_DASHBOARD_URL=https://YOUR-GITHUB-USER.github.io/soil-monitor/
